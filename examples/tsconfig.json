{
    "compilerOptions": {
        "sourceMap": true,
        "noImplicitAny": false,
        "module": "esnext",
        "target": "es2018",
        "lib": [
            "esnext",
            "dom",
            "dom.iterable"
        ],
        "declaration": true,
        "removeComments": false,
        "allowSyntheticDefaultImports": true,
        "jsx": "react",
        "allowJs": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "paths": {
            "rlayers": [
                "../src"
            ],
            "rlayers/*": [
                "../src/*"
            ],
        }
    },
    "include": [
        ".",
        "../src"
    ]
}
