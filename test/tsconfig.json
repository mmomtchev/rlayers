{
    "compilerOptions": {
        "sourceMap": true,
        "noImplicitAny": false,
        "module": "commonjs",
        "target": "es6",
        "lib": [
            "esnext",
            "dom",
            "dom.iterable"
        ],
        "types": [
            "jest"
        ],
        "removeComments": true,
        "allowSyntheticDefaultImports": true,
        "jsx": "react",
        "allowJs": true,
        "strict": true,
        "strictNullChecks": false,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "paths": {
            "rlayers": [
                "../src"
            ],
            "rlayers/*": [
                "../src/*"
            ]
        }
    },
    "include": [
        ".",
        "../src"
    ],
    "exclude": [
        "*.js"
    ]
}
