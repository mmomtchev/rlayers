{
    "compilerOptions": {
        "sourceMap": true,
        "noImplicitAny": false,
        "lib": [
            "esnext",
            "dom",
            "dom.iterable"
        ],
        "declaration": true,
        "declarationMap": true,
        "removeComments": false,
        "allowSyntheticDefaultImports": true,
        "jsx": "react",
        "allowJs": true,
        "strict": false,
        "strictNullChecks": false,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "rootDir": "./src",
        "types": [
            "node"
        ],
        "paths": {
            "rlayers": [
                "./src"
            ],
            "rlayers/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "./src"
    ],
    "exclude": [],
    "ts-node": {
        "transpileOnly": true
    }
}
